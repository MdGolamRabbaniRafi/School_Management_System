{
  "openapi": "3.0.1",
  "info": {
    "title": "Backend",
    "version": "1.0"
  },
  "paths": {
    "/auth/signUp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "BloodGroup",
                  "DateOfBirth",
                  "Email",
                  "FirstName",
                  "Password",
                  "UserType"
                ],
                "type": "object",
                "properties": {
                  "Id": {
                    "type": "string"
                  },
                  "CreatedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "FirstName": {
                    "maxLength": 100,
                    "minLength": 0,
                    "type": "string"
                  },
                  "Email": {
                    "pattern": "^[\\w-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$",
                    "type": "string",
                    "format": "email"
                  },
                  "DateOfBirth": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "Password": {
                    "maxLength": 100,
                    "minLength": 6,
                    "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d@$!%*?&]{6,}$",
                    "type": "string"
                  },
                  "BloodGroup": {
                    "$ref": "#/components/schemas/BloodGroupEnum"
                  },
                  "UserType": {
                    "$ref": "#/components/schemas/UserTypeEnum"
                  },
                  "ProfilePicture": {
                    "type": "string",
                    "format": "binary"
                  },
                  "ProfileImagePath": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "Id": {
                  "style": "form"
                },
                "CreatedAt": {
                  "style": "form"
                },
                "FirstName": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "DateOfBirth": {
                  "style": "form"
                },
                "Password": {
                  "style": "form"
                },
                "BloodGroup": {
                  "style": "form"
                },
                "UserType": {
                  "style": "form"
                },
                "ProfilePicture": {
                  "style": "form"
                },
                "ProfileImagePath": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/email/verify-otp": {
      "post": {
        "tags": [
          "Email"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "otp",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/check": {
      "get": {
        "tags": [
          "HealthCheck"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/add": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "BloodGroup",
                  "DateOfBirth",
                  "Email",
                  "FirstName",
                  "Password",
                  "UserType"
                ],
                "type": "object",
                "properties": {
                  "Id": {
                    "type": "string"
                  },
                  "CreatedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "FirstName": {
                    "maxLength": 100,
                    "minLength": 0,
                    "type": "string"
                  },
                  "Email": {
                    "pattern": "^[\\w-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$",
                    "type": "string",
                    "format": "email"
                  },
                  "DateOfBirth": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "Password": {
                    "maxLength": 100,
                    "minLength": 6,
                    "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d@$!%*?&]{6,}$",
                    "type": "string"
                  },
                  "BloodGroup": {
                    "$ref": "#/components/schemas/BloodGroupEnum"
                  },
                  "UserType": {
                    "$ref": "#/components/schemas/UserTypeEnum"
                  },
                  "ProfilePicture": {
                    "type": "string",
                    "format": "binary"
                  },
                  "ProfileImagePath": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "Id": {
                  "style": "form"
                },
                "CreatedAt": {
                  "style": "form"
                },
                "FirstName": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "DateOfBirth": {
                  "style": "form"
                },
                "Password": {
                  "style": "form"
                },
                "BloodGroup": {
                  "style": "form"
                },
                "UserType": {
                  "style": "form"
                },
                "ProfilePicture": {
                  "style": "form"
                },
                "ProfileImagePath": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/findAll": {
      "get": {
        "tags": [
          "User"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BloodGroupEnum": {
        "enum": [
          "a_Positive",
          "a_Negative",
          "b_Positive",
          "b_Negative",
          "aB_Positive",
          "aB_Negative",
          "o_Positive",
          "o_Negative"
        ],
        "type": "string"
      },
      "UserTypeEnum": {
        "enum": [
          "administrator",
          "principal",
          "teacher",
          "student",
          "parent",
          "accountant",
          "librarian",
          "transportStaff",
          "hrStaff"
        ],
        "type": "string"
      }
    }
  }
}